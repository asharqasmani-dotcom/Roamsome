{%- comment -%}
  ==========================================================================
  ROAMSOME — Ad Landing: Live Shopify Products
  --------------------------------------------------------------------------
  LIVE PRODUCTS ONLY. Products are pulled from a real Shopify collection
  (default: "food-boxes"). Only products published to the Online Store are
  ever accessible here, so nothing dummy can appear. Cards reuse the theme's
  existing 'product-card' snippet + .plans-grid so they match the homepage /
  collection page exactly.

  If the collection is empty or missing, the section shows a single CTA
  button to the collection page instead of any placeholder cards.
  ==========================================================================
{%- endcomment -%}

{%- assign product_collection = collections[section.settings.collection] -%}
{%- assign fallback_url = product_collection.url | default: routes.all_products_collection_url -%}

<section class="section{% if section.settings.soft_background %} section-soft{% endif %} ad-products">
  <div class="container">
    <div class="section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if product_collection != blank and product_collection.products_count > 0 -%}
      <div class="plans-grid">
        {%- for product in product_collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product, featured: forloop.first, badge_text: product.metafields.custom.badge -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} No live products available — show a single CTA, never placeholder cards. {%- endcomment -%}
      <div class="ad-products-cta">
        <a class="btn" href="{{ fallback_url }}">{{ section.settings.empty_button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .ad-products .ad-products-cta {
    display: flex;
    justify-content: center;
  }
</style>

{% schema %}
{
  "name": "Live products",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "soft_background", "label": "Use soft (cream) background", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subscription plans" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the plan that fits your week" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every subscription includes free UK delivery and the freedom to skip, pause or cancel anytime." },
    { "type": "collection", "id": "collection", "label": "Product collection", "info": "Only live, published products from this collection are shown." },
    { "type": "range", "id": "products_to_show", "label": "Maximum products to show", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "empty_button_label", "label": "Fallback button label", "info": "Shown only if the collection has no live products.", "default": "View all boxes" }
  ],
  "presets": [
    { "name": "Live products" }
  ]
}
{% endschema %}
