{%- comment -%}
  ==========================================================================
  ROAMSOME — Ad Landing: Editorial Image Gallery
  --------------------------------------------------------------------------
  REAL IMAGES ONLY. Add "Gallery image" blocks in the theme editor. The
  first image becomes the large feature; the rest fill the supporting grid.
  Renders nothing on the live site until at least one image is added.
  All CSS scoped to .ad-gallery-section. Images lazy-load (below the fold).
  ==========================================================================
{%- endcomment -%}

{%- assign image_blocks = section.blocks | where: 'type', 'image' -%}
{%- assign image_count = image_blocks | size -%}

{%- if image_count > 0 -%}
  <section class="section{% if section.settings.soft_background %} section-soft{% endif %} ad-gallery-section">
    <div class="container">
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="ad-gallery">
        {%- for block in image_blocks -%}
          {%- if forloop.first -%}
            <figure class="ad-gallery-feature" {{ block.shopify_attributes }}>
              <img
                src="{{ block.settings.image | image_url: width: 1400 }}"
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
                width="1400"
                height="1050"
              >
            </figure>
            {%- if image_count > 1 -%}<div class="ad-gallery-supporting">{%- endif -%}
          {%- else -%}
            <figure class="ad-gallery-tile" {{ block.shopify_attributes }}>
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
                width="800"
                height="600"
              >
            </figure>
            {%- if forloop.last -%}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <style>
    .ad-gallery-section .ad-gallery {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 22px;
      align-items: stretch;
    }
    .ad-gallery-section .ad-gallery-feature,
    .ad-gallery-section .ad-gallery-tile {
      margin: 0;
      overflow: hidden;
      border-radius: var(--radius-card);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-soft);
      background: var(--color-secondary);
    }
    .ad-gallery-section .ad-gallery-feature {
      min-height: 100%;
    }
    .ad-gallery-section .ad-gallery-feature img {
      width: 100%;
      height: 100%;
      min-height: 420px;
      object-fit: cover;
    }
    .ad-gallery-section .ad-gallery-supporting {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
    .ad-gallery-section .ad-gallery-tile img {
      width: 100%;
      height: 100%;
      aspect-ratio: var(--media-ratio);
      object-fit: cover;
    }
    /* Only one image: let the feature run full width */
    .ad-gallery-section .ad-gallery:not(:has(.ad-gallery-supporting)) {
      grid-template-columns: 1fr;
    }
    @media (max-width: 1080px) {
      .ad-gallery-section .ad-gallery { grid-template-columns: 1fr; }
      .ad-gallery-section .ad-gallery-feature img { min-height: 320px; }
    }
    @media (max-width: 760px) {
      .ad-gallery-section .ad-gallery-supporting { grid-template-columns: 1fr; }
    }
  </style>

{%- elsif request.design_mode -%}
  <section class="section ad-gallery-section">
    <div class="container">
      <article class="summary-card" style="text-align:center;">
        <h3>Image gallery is ready — add your real photos</h3>
        <p>Click <strong>Add block &rarr; Gallery image</strong> to add real product / lifestyle photos. The first image becomes the large feature; the rest fill the supporting grid. This section stays hidden until you add at least one image.</p>
      </article>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Image gallery",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "soft_background", "label": "Use soft (cream) background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium ingredients, beautifully prepared" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A look at the real ingredients, recipe cards and destination moments from ROAMSOME boxes." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "ROAMSOME meal kit" }
      ]
    }
  ],
  "presets": [
    { "name": "Image gallery" }
  ]
}
{% endschema %}
