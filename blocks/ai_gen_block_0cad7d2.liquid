{% doc %}
  @prompt
    Create a video hero section that displays a vertical/portrait MP4 video in a centred narrow column on desktop (like a phone frame or Instagram reel style, roughly 400px wide, centred on the page with padding on either side), and full-width full-screen on mobile. The video should autoplay, be muted, loop, and have playsinline set. Include a text setting for the MP4 file URL (video_file). Add optional heading and subheading overlay text. The desktop background around the narrow video column should be a solid colour (customisable setting). Keep the overall section height tall enough to show the full portrait video on both desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: {{ block.settings.desktop_background_color }};
    overflow: hidden;
  }

  .ai-video-hero__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-video-hero__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_video_width }}px;
    max-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-hero__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.desktop_border_radius }}px;
  }

  .ai-video-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
    z-index: 2;
    pointer-events: none;
  }

  .ai-video-hero__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    max-width: 90%;
  }

  .ai-video-hero__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    max-width: 90%;
  }

  .ai-video-hero__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.desktop_border_radius }}px;
  }

  .ai-video-hero__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-video-hero__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    max-width: 80%;
  }

  @media screen and (max-width: 749px) {
    .ai-video-hero__container-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-video-hero__video-wrapper-{{ ai_gen_id }} {
      width: 100%;
      border-radius: 0;
    }

    .ai-video-hero__video-{{ ai_gen_id }} {
      border-radius: 0;
    }

    .ai-video-hero__placeholder-{{ ai_gen_id }} {
      border-radius: 0;
    }

    .ai-video-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-video-hero__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<video-hero-{{ ai_gen_id }}
  class="ai-video-hero-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-hero__container-{{ ai_gen_id }}">
    <div class="ai-video-hero__video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.video_file != blank %}
        <video
          class="ai-video-hero__video-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
          aria-label="Hero video"
        >
          <source src="{{ block.settings.video_file }}" type="video/mp4">
        </video>
      {% else %}
        <div class="ai-video-hero__placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-video-hero__empty-state-{{ ai_gen_id }}">
            Next, add your portrait MP4 video URL
          </div>
        </div>
      {% endif %}

      {% if block.settings.heading != blank or block.settings.subheading != blank %}
        <div class="ai-video-hero__overlay-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h1 class="ai-video-hero__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
          {% endif %}
          {% if block.settings.subheading != blank %}
            <p class="ai-video-hero__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</video-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('.ai-video-hero__video-{{ ai_gen_id }}');
        if (video) {
          video.play().catch(function(error) {
            console.log('Video autoplay failed:', error);
          });
        }
      }
    }

    customElements.define('video-hero-{{ ai_gen_id }}', VideoHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Portrait video hero",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_file",
      "label": "MP4 video URL"
    },
    {
      "type": "range",
      "id": "desktop_video_width",
      "label": "Desktop video width",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "desktop_border_radius",
      "label": "Desktop border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#f6f4e7"
    },
    {
      "type": "header",
      "content": "Overlay text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Portrait video hero"
    }
  ]
}
{% endschema %}
